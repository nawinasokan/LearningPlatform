DATABASE_URL=postgresql+asyncpg://interview_user:replace-password@postgres:5432/interview_academy
SYNC_DATABASE_URL=postgresql://interview_user:replace-password@postgres:5432/interview_academy
SANDBOX_DATABASE_URL=postgresql://interview_user:replace-password@postgres:5432/interview_sandbox
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:80
UPLOAD_DIR=/app/uploads
LOG_LEVEL=INFO

# PostgreSQL container
POSTGRES_USER=interview_user
POSTGRES_PASSWORD=replace-password
POSTGRES_DB=interview_academy
SANDBOX_DB_PASSWORD=replace-sandbox-password
